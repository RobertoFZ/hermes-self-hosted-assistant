{
  "$schema": "https://paseo.sh/schemas/paseo.config.v1.json",
  "version": 1,
  "daemon": {
    "listen": "127.0.0.1:6767",
    "cors": {
      "allowedOrigins": [
        "https://app.paseo.sh"
      ]
    },
    "relay": {
      "enabled": false
    }
  },
  "app": {
    "baseUrl": "https://app.paseo.sh"
  },
  "agents": {
    "providers": {
      "codex-review": {
        "extends": "codex",
        "label": "Codex PR review",
        "description": "Unattended PR reviews with server-enforced read-only Linear access",
        "command": [
          "codex",
          "-c",
          "mcp_servers.linear.url=\"https://mcp.linear.app/mcp/readonly\""
        ]
      }
    }
  },
  "features": {
    "dictation": {
      "enabled": false
    },
    "voiceMode": {
      "enabled": false
    }
  }
}
