# Required by the locally exposed Hermes web dashboard.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# Authenticates direct access to Paseo's loopback-only bundled web UI.
PASEO_PASSWORD=
PASEO_HOST_PORT=6767

# VPS loopback port forwarded to the temporary in-container Linear OAuth proxy.
# Change only this host side when 5555 is occupied; Codex still uses local 5555.
LINEAR_OAUTH_CALLBACK_HOST_PORT=5555

# Keep the default to reuse an existing installation when this repository is
# cloned into a different directory. Changing it selects a different volume.
HERMES_DATA_VOLUME=self-assistant-hermes-data

# Pin HERMES_BASE_IMAGE to a tested tag or digest for production deployments.
HERMES_BASE_IMAGE=nousresearch/hermes-agent:latest
HERMES_LOCAL_IMAGE=hermes-self-hosted-assistant:local
PASEO_BASE_IMAGE=node:22-bookworm-slim
PASEO_LOCAL_IMAGE=self-assistant-paseo:local
CODEX_VERSION=0.156.0
PASEO_VERSION=0.5.2

# Optional until GitHub PR access is enabled. Use a repository-scoped token.
GITHUB_TOKEN=

# Hermes and the standalone Codex CLI use separate persisted ChatGPT OAuth
# stores; neither requires an OPENAI_API_KEY for subscription access.
