@@ -0,0 +1,33 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+from expects import equal, expect
+
+from dynamic_pricing.apps.web.services.routes.route_summary_service import (
+    RouteSummaryService,
+)
+
+pytestmark = pytest.mark.django_db
+
+REFERENCE_NOW = datetime(2026, 1, 10, 12, 0, tzinfo=timezone.utc)
+EXPECTED_AGE_HOURS = 5.0
+
+
+def test_currency_rate_age_hours_returns_elapsed_hours(currency_rate_factory) -> None:
+    captured_at = REFERENCE_NOW - timedelta(hours=EXPECTED_AGE_HOURS)
+    rate = currency_rate_factory(captured_at=captured_at)
+
+    age = RouteSummaryService.currency_rate_age_hours(rate, now=REFERENCE_NOW)
+
+    expect(age).to(equal(EXPECTED_AGE_HOURS))
+
+
+def test_currency_rate_age_hours_clamps_future_rate_to_zero(currency_rate_factory) -> None:
+    captured_at = REFERENCE_NOW + timedelta(hours=2)
+    rate = currency_rate_factory(captured_at=captured_at)
+
+    age = RouteSummaryService.currency_rate_age_hours(rate, now=REFERENCE_NOW)
+
+    expect(age).to(equal(0.0))
