     currency_rate_age_hours = serializers.SerializerMethodField()

     class Meta:
-        fields = ["id", "name"]
+        fields: ClassVar = ["id", "name", "currency_rate_age_hours"]
         model = Route
+
+    def get_currency_rate_age_hours(self, route: Route) -> float | None:
+        """Return the age in hours of the route's active currency rate."""
