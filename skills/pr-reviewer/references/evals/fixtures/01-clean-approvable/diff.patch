+
+    @staticmethod
+    def currency_rate_age_hours(rate: CurrencyRate, now: datetime | None = None) -> float:
+        """Return how many hours old the currency rate is, clamped at zero.
+
+        Args:
+            rate: The currency rate whose freshness is being measured.
+            now: Reference instant; defaults to the current UTC time.
+
+        Returns:
+            Age of the rate in hours, never negative.
+        """
+        reference = now or datetime.now(timezone.utc)
+        delta_seconds = (reference - rate.captured_at).total_seconds()
+        return max(0.0, delta_seconds / SECONDS_PER_HOUR)
