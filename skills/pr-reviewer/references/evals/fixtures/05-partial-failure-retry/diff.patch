+from expects import be_false, equal, expect
+
+from dynamic_pricing.apps.web.services.expired_strategy_deactivation_service import (
+    ExpiredStrategyDeactivationService,
+)
+
+
+def test_run_deactivates_expired_strategy(
+    expired_strategy,
+    active_trip_fare,
+):
+    active_trip_fare.strategy = expired_strategy
+    active_trip_fare.save()
+
+    failed_strategy_ids = ExpiredStrategyDeactivationService.run()
+
+    expired_strategy.refresh_from_db()
+    active_trip_fare.refresh_from_db()
+    expect(failed_strategy_ids).to(equal([]))
+    expect(expired_strategy.status).to(be_false)
+    expect(active_trip_fare.active).to(be_false)
