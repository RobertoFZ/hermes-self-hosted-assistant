+from dynamic_pricing.apps.web.models import Strategy
+from dynamic_pricing.integrations.strategy_sync import notify_strategy_disabled
+
+
+class ExpiredStrategyDeactivationService:
+    @classmethod
+    def run(cls) -> list[int]:
+        failed_strategy_ids = []
+        strategies = Strategy.objects.filter(
+            status=True,
+            end_date__lt=timezone.localdate(),
+        )
+
+        for strategy in strategies:
+            try:
+                cls._deactivate(strategy)
+            except Exception:
+                failed_strategy_ids.append(strategy.id)
+
+        return failed_strategy_ids
+
+    @staticmethod
+    def _deactivate(strategy: Strategy) -> None:
+        strategy.status = False
+        strategy.save(update_fields=["status"])
+
+        strategy.trip_fares.update(active=False)
+        notify_strategy_disabled(strategy.id)
