{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Read-only pull-request review proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "pr_number",
    "head_sha",
    "baseline_head_sha",
    "event",
    "published",
    "product_context",
    "objective",
    "summary",
    "findings",
    "delta",
    "linear",
    "limitations"
  ],
  "properties": {
    "repo": {"type": "string", "minLength": 1},
    "pr_number": {"type": "integer", "minimum": 1},
    "head_sha": {"type": "string", "minLength": 7},
    "baseline_head_sha": {"type": ["string", "null"], "minLength": 7},
    "event": {"type": "string", "enum": ["APPROVE", "COMMENT"]},
    "published": {"type": "boolean", "const": false},
    "product_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_type", "why", "current_behavior", "planned_behavior",
        "pr_scope", "delivery_stage", "related_prs", "source_paths"
      ],
      "properties": {
        "change_type": {
          "type": "string",
          "enum": ["feature", "fix", "architecture", "maintenance", "mixed", "unknown"]
        },
        "why": {"type": ["string", "null"], "maxLength": 1000},
        "current_behavior": {"type": ["string", "null"], "maxLength": 1000},
        "planned_behavior": {"type": ["string", "null"], "maxLength": 1000},
        "pr_scope": {"type": "string", "minLength": 1, "maxLength": 1000},
        "delivery_stage": {
          "type": "string",
          "enum": ["specification", "implementation", "mixed", "unknown"]
        },
        "related_prs": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "role"],
            "properties": {
              "url": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[1-9][0-9]*$"},
              "role": {"type": "string", "minLength": 1, "maxLength": 100}
            }
          }
        },
        "source_paths": {
          "type": "array",
          "maxItems": 5,
          "items": {"type": "string", "minLength": 1, "maxLength": 300}
        }
      }
    },
    "objective": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "category",
          "severity",
          "path",
          "line",
          "side",
          "start_line",
          "start_side",
          "body",
          "evidence",
          "blocking"
        ],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^C[1-9][0-9]*$"},
          "category": {
            "type": "string",
            "enum": [
              "correctness",
              "security",
              "data_layer",
              "migration_safety",
              "architecture",
              "test_coverage",
              "error_handling",
              "scraper"
            ]
          },
          "severity": {
            "type": "string",
            "enum": ["blocker", "major", "minor", "nit"]
          },
          "path": {"type": ["string", "null"], "minLength": 1},
          "line": {"type": ["integer", "null"], "minimum": 1},
          "side": {"type": ["string", "null"], "enum": ["LEFT", "RIGHT", null]},
          "start_line": {"type": ["integer", "null"], "minimum": 1},
          "start_side": {"type": ["string", "null"], "enum": ["LEFT", "RIGHT", null]},
          "body": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean"}
        }
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "addressed_candidate_ids",
        "still_open_candidate_ids",
        "new_candidate_ids"
      ],
      "properties": {
        "status": {"type": "string", "enum": ["initial", "available", "unavailable"]},
        "summary": {"type": ["string", "null"]},
        "addressed_candidate_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^C[1-9][0-9]*$"}
        },
        "still_open_candidate_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^C[1-9][0-9]*$"}
        },
        "new_candidate_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^C[1-9][0-9]*$"}
        }
      }
    },
    "linear": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fetch_status", "key", "title", "url", "status", "project", "product_summary", "acceptance_criteria", "labels"],
      "properties": {
        "fetch_status": {"type": "string", "enum": ["available", "missing", "unavailable"]},
        "key": {"type": ["string", "null"]},
        "title": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"]},
        "status": {"type": ["string", "null"]},
        "project": {"type": ["string", "null"]},
        "product_summary": {"type": ["string", "null"]},
        "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
        "labels": {"type": "array", "items": {"type": "string"}}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
