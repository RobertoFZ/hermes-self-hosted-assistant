# Non-secret review deployment policy. Copy this file to .review.env and fill
# in the Slack IDs. The local file is ignored so each installation can have an
# independent policy.

# Complete Hermes gateway allowlist: owner, delegated reviewers, and every
# trusted review bot ID so Slack admits their events.
SLACK_ALLOWED_USERS=

# Owner keeps normal Slack DM access. Delegated reviewers remain review-only.
SLACK_REVIEW_OWNER_USER_IDS=
SLACK_REVIEWER_USER_IDS=
# Trusted bots may initiate reviews only in the review channel and only when
# their message has review-request intent plus an exact allowlisted PR URL.
SLACK_REVIEW_BOT_USER_IDS=
# Bots that own explicitly addressed review requests. When a human mentions one
# of these bots without mentioning Hermes, Hermes ignores the message.
SLACK_REVIEW_COMPETING_BOT_USER_IDS=
SLACK_REVIEW_CHANNEL_ID=

# Sole private decision owner and daily digest recipient. When blank, exactly
# one SLACK_REVIEW_OWNER_USER_IDS value must exist and becomes the owner.
# When set, this ID must also appear in SLACK_REVIEW_OWNER_USER_IDS.
SLACK_REVIEW_DIGEST_USER_ID=

# Bounded intake and proposal analysis. Repeated URLs for the same PR are
# coalesced by the durable workflow rather than consuming another slot.
SLACK_REVIEW_MAX_URLS_PER_MESSAGE=5
SLACK_REVIEW_MAX_ACTIVE_PER_REQUESTER=5
SLACK_REVIEW_MAX_QUEUED=50
SLACK_REVIEW_PROPOSAL_CONCURRENCY=3

# Hermes evaluates config/crons.json in this process timezone. The repository
# default sends the daily digest at 17:00 Mexico City time.
TZ=America/Mexico_City

# Comma-separated owner/repository allowlist accepted from Slack messages.
SLACK_REVIEW_ALLOWED_REPOSITORIES=reservamos/reserhub-revenue-full,reservamos/price-engine-python,reservamos/reserhub-intelligence-api,reservamos/reserhub-revenue-admin,reservamos/reserhub-revenue-web,reservamos/scrapers-swarm

# Review workspace stored in the persistent Docker volume.
REVIEW_MONOREPO_REPOSITORY=reservamos/reserhub-revenue-full
REVIEW_MONOREPO_ROOT=/opt/data/repos/reserhub-revenue-full
REVIEW_SUBMODULES=price-engine-python,reserhub-intelligence-api,reserhub-revenue-admin,reserhub-revenue-web,scrapers-swarm

# Delegated Codex review execution and persistent review history.
PASEO_HOST=paseo:6767
REVIEW_PASEO_TIMEOUT=45m
REVIEW_HISTORY_DB=/opt/data/review-history/reviews.sqlite3
